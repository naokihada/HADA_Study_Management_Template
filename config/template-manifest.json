{
  "template_id": "hada-study-management-template",
  "template_version": "1.2.0",
  "schema_version": "1.0.0",
  "data_format_version": "1.0.0",
  "ownership": {
    "template_owned": ["AGENTS.md", "README.md", "TEMPLATE_BASE.md", "config/**", "tools/**", "tests/**", "templates/**", "prompts/**"],
    "user_owned": ["data/**", "plans/**", "records/**", "artifacts/**", "config/project-state.yaml", "config/domain-compatibility.yaml"],
    "generated": ["reports/**", "records/**/summaries/**"]
  },
  "migration_paths": [
    {
      "from": "1.0.0",
      "to": "1.2.0",
      "status": "current",
      "strategy": "three-way-review",
      "automatic_data_migration": false
    }
  ],
  "upgrade_contract": {
    "baseline": "1.2.0",
    "comparison": ["previous_template", "current_project", "new_template"],
    "user_data_policy": "preserve",
    "automatic_deletion": false,
    "git_operations": "manual",
    "unknown_state": "review_required"
  },
  "notes": "v1.2.0 is the current template baseline; schema and data format remain 1.0.0. External import is included."
}
