{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "template_id",
    "template_version",
    "schema_version",
    "data_format_version",
    "ownership",
    "upgrade_contract"
  ],
  "properties": {
    "template_id": {"type": "string", "minLength": 1},
    "template_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "data_format_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "ownership": {
      "type": "object",
      "required": ["template_owned", "user_owned", "generated", "reference", "master", "unknown", "review_required"],
      "properties": {
        "template_owned": {"type": "array", "items": {"type": "string"}},
        "user_owned": {"type": "array", "items": {"type": "string"}},
        "generated": {"type": "array", "items": {"type": "string"}},
        "reference": {"type": "array", "items": {"type": "string"}},
        "master": {"type": "array", "items": {"type": "string"}},
        "unknown": {"type": "array", "items": {"type": "string"}},
        "review_required": {"type": "array", "items": {"type": "string"}}
      }
    },
    "migration_paths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "status", "strategy", "automatic_data_migration"],
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "status": {"type": "string"},
          "strategy": {"type": "string"},
          "automatic_data_migration": {"const": false}
        }
      }
    },
    "public_artifact_contract": {
      "type": "object",
      "required": [
        "required_files",
        "allowed_files",
        "forbidden_files",
        "forbidden_prefixes",
        "template_forbidden_prefixes"
      ],
      "properties": {
        "required_files": {"type": "array", "items": {"type": "string"}},
        "allowed_files": {"type": "array", "items": {"type": "string"}},
        "forbidden_files": {"type": "array", "items": {"type": "string"}},
        "forbidden_prefixes": {"type": "array", "items": {"type": "string"}},
        "template_forbidden_prefixes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "upgrade_contract": {
      "type": "object",
      "required": [
        "baseline",
        "comparison",
        "user_data_policy",
        "automatic_deletion",
        "git_operations",
        "unknown_state",
        "candidate_required",
        "legacy_bootstrap",
        "evidence_root",
        "status_codes",
        "source_policy"
      ],
      "properties": {
        "baseline": {"type": "string"},
        "comparison": {"type": "array", "items": {"type": "string"}},
        "user_data_policy": {"const": "preserve"},
        "automatic_deletion": {"const": false},
        "git_operations": {"const": "manual"},
        "unknown_state": {"const": "review_required"},
        "candidate_required": {"const": true},
        "legacy_bootstrap": {"const": true},
        "evidence_root": {"type": "string"},
        "status_codes": {"type": "object"},
        "source_policy": {"type": "object"}
      }
    }
  }
}

